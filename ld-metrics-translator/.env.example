# L&D Metrics Translator Environment Configuration
# Copy this file to .env and update the values for your environment

# Application Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///ld_metrics.db
# For PostgreSQL: postgresql://username:password@localhost/ld_metrics
# For MySQL: mysql://username:password@localhost/ld_metrics

# Security Settings
SESSION_COOKIE_SECURE=false
WTF_CSRF_ENABLED=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Email Configuration (for error notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@ldmetrics.com
ADMINS=admin@example.com,support@example.com

# Rate Limiting
REDIS_URL=redis://localhost:6379/0
RATELIMIT_DEFAULT=100 per hour

# Monitoring and Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ENABLE_METRICS=false

# Performance Settings
SQLALCHEMY_RECORD_QUERIES=false

# Production Settings (set these in production)
# SESSION_COOKIE_SECURE=true
# FLASK_ENV=production
# LOG_LEVEL=WARNING
