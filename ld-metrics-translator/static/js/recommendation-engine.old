    initializeCombinationRules() {
        return [
            {
                combination: ['operational', 'behavioral'],
                synergy: 0.8,
                title: 'Performance & Culture Balance',
                description: 'Combining operational efficiency with behavioral insights creates a holistic view of learning impact.',
                recommendedMetrics: [
                    'Time to Competency + Active Participation',
                    'Employee Turnover Rate + Voluntary Learning Hours',
                    'Training ROI + Peer Knowledge Sharing'
                ]
            },
            {
                combination: ['operational', 'neuroscience'],
                synergy: 0.9,
                title: 'Data-Driven Learning Optimization',
                description: 'Scientific measurement of learning effectiveness with clear business outcomes.',
                recommendedMetrics: [
                    'Completion Rate + Memory Consolidation',
                    'Cost per Hire + Cognitive Load Assessment',
                    'Performance Improvement + Attention Metrics'
                ]
            },
            {
                combination: ['behavioral', 'neuroscience'],
                synergy: 0.85,
                title: 'Human-Centered Learning Design',
                description: 'Understanding both motivation and cognitive processes for optimal learning experiences.',
                recommendedMetrics: [
                    'Engagement Score + Flow State Frequency',
                    'Collaboration Index + Neuroplasticity',
                    'Learning Motivation + Stress Response'
                ]
            },
            {
                combination: ['operational', 'behavioral', 'neuroscience'],
                synergy: 0.95,
                title: 'Comprehensive Learning Analytics',
                description: 'The gold standard: business impact, human behavior, and cognitive science combined.',
                recommendedMetrics: [
                    'ROI + Engagement + Memory Retention',
                    'Efficiency + Motivation + Cognitive Load',
